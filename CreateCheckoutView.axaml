<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ksiegarnia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:CreateCheckoutViewModel"
             x:Class="Ksiegarnia.Views.CreateCheckoutView"
             Background="#F5F5F5" Foreground="#3F51B5">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Text="Create Checkout" Foreground="#3F51B5" />

		<Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Content="Book:" Foreground="#3F51B5" />
		<ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,10" ItemsSource="{Binding Books}" SelectedValue="{Binding CheckoutBook}" VerticalAlignment="Center" Background="#FFFFFF" Foreground="#3F51B5">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Title}" Foreground="#3F51B5" />
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>

		<Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Content="Last Name:" Foreground="#3F51B5" />
		<TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,10" Text="{Binding CheckoutLastName}" Background="#FFFFFF" Foreground="#3F51B5" />

		<Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Content="Phone:" Foreground="#3F51B5" />
		<TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,10" Text="{Binding CheckoutPhone}" Background="#FFFFFF" Foreground="#3F51B5" />

		<Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Content="From:" Foreground="#3F51B5" />
		<DatePicker Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,10" SelectedDate="{Binding CheckoutFrom}" Foreground="#3F51B5" />

		<Label Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Content="To:" Foreground="#3F51B5" />
		<DatePicker Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,10" SelectedDate="{Binding CheckoutTo}" Foreground="#3F51B5" />

		<StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
			<Button Margin="10" Padding="10" Content="Create" Width="100" Background="#4CAF50" Foreground="White" Command="{Binding CreateCommand}" HorizontalContentAlignment="Center" />
			<Button Margin="10" Padding="10" Content="Back" Width="100" Background="#FF4081" Foreground="White" Command="{Binding BackCommand}" HorizontalContentAlignment="Center" />
		</StackPanel>
	</Grid>
</UserControl>
