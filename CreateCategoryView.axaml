<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ksiegarnia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:CreateBookViewModel"
             x:Class="Ksiegarnia.Views.CreateCategoryView" Background="#F5F5F5" Foreground="#3F51B5">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Text="Create New Category" Foreground="#3F51B5" />

		<Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Content="Name:" Foreground="#3F51B5" />
		<TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="10" Text="{Binding CategoryName}" Background="#FFFFFF" Foreground="#3F51B5" />

		<StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
			<Button Margin="10" Content="Back" Width="100" Padding="10" Background="#FF4081" Foreground="White" Command="{Binding BackCommand}" HorizontalContentAlignment="Center" />
			<Button Margin="10" Content="Create Category" Width="140" Padding="10" Background="#4CAF50" Foreground="White" Command="{Binding CreateCategoryCommand}" HorizontalContentAlignment="Center" />
		</StackPanel>
	</Grid>
</UserControl>
